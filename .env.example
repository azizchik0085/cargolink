# ==========================================
# CARGOLINK PRODUCTION CONFIGURATION
# ==========================================
# IMPORTANT: Generate secure random secrets before deploying!
# Example generator: openssl rand -hex 32

ENVIRONMENT=production
PROJECT_NAME="CARGOLINK International Freight Marketplace"
API_V1_STR="/api/v1"
DOMAIN_NAME=cargolink.io
ADMIN_EMAIL=admin@cargolink.io

# Security
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL + PostGIS
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=cargolink
POSTGRES_USER=cargolink_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://cargolink_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/cargolink
SYNC_DATABASE_URL=postgresql://cargolink_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/cargolink

# Redis Cache & Sessions
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# Storage
UPLOAD_DIR=/app/uploads

# CORS
BACKEND_CORS_ORIGINS=["https://cargolink.io","https://www.cargolink.io","https://app.cargolink.io"]

# Business Policy Constants
FREE_DRIVER_ACCESS=true
TRANSACTION_COMMISSION_PERCENT=0.0
